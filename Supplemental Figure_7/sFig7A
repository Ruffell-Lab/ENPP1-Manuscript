## ---------------- helpers ----------------
norm_names <- function(x){ x <- toupper(x); x <- gsub("[^A-Z0-9]+","_", x); gsub("^_|_$","", x) }
to_up      <- function(z) toupper(trimws(as.character(z)))

## Map receptor text to negative/positive/NA
is_neg <- function(v) {
  s <- to_up(v)
  ifelse(grepl("NEG|NOT[_ ]?AMP(LIFIED)?|0", s),
         TRUE,
         ifelse(grepl("POS|AMP(LIFIED)?|1|POSITIVE", s), FALSE, NA))
}

## ---------------- 1) Clinical OS ----------------
read_clin <- function(path){
  if (!file.exists(path)) return(NULL)
  df <- data.table::fread(path, sep="\t", quote="", data.table=FALSE, na.strings=c("","NA","NaN"))
  names(df) <- norm_names(names(df)); df
}
pick_col <- function(df, pats){
  nm <- names(df)
  for (p in pats) {
    hit <- nm[grepl(p, nm, perl=TRUE)]
    if (length(hit)) return(hit[1])
  }
  NA_character_
}
extract_os <- function(df){
  if (is.null(df)) return(NULL)
  pc <- function(p) pick_col(df, p)
  pat_col <- pc(c("^PATIENT_IDENTIFIER$","^PATIENT_ID$","^CASE_ID$","^BCR_PATIENT_BARCODE$",
                  "^SUBMITTER_ID$","^PATIENT_BARCODE$","^PATIENT$"))
  pid <- if (!is.na(pat_col)) toupper(df[[pat_col]]) else NA
  
  os_m_col <- pc(c("^OS_MONTHS$","^OVERALL_SURVIVAL_MONTHS$","^OS_TIME$","^MONTHS_TO_LAST_FOLLOWUP$"))
  os_s_col <- pc(c("^OS_STATUS$","^OVERALL_SURVIVAL_STATUS$","^OS_EVENT$","^VITAL_STATUS$"))
  
  os_m <- if (!is.na(os_m_col)) suppressWarnings(as.numeric(df[[os_m_col]])) else NA_real_
  st   <- if (!is.na(os_s_col)) to_up(df[[os_s_col]]) else NA
  os_e <- if (!all(is.na(st))) ifelse(grepl("(^1|DECEASED|DEAD)", st), 1L,
                                      ifelse(grepl("(^0|LIVING|ALIVE)", st), 0L, NA_integer_)) else NA_integer_
  
  tibble(patient_id = pid, OS_months=os_m, OS_event=os_e)
}

cA <- read_clin(file.path(datadir, "data_clinical_patient.txt"))
cB <- read_clin(file.path(datadir, "brca_tcga_pan_can_atlas_2018_clinical_data.tsv"))
