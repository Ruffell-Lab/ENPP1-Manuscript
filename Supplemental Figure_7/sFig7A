            OS_event  = coalesce(as.numeric(OS_event.a),  as.numeric(OS_event.b))) %>%
  dplyr::filter(!is.na(patient_id))

## ---------------- 2) ENPP1 (log2(RSEM+1), primary tumors) --------------
expr_file <- file.path(datadir, "data_mrna_seq_v2_rsem.txt")
stopifnot(file.exists(expr_file))
expr <- data.table::fread(expr_file, data.table=FALSE, check.names=FALSE)
colnames(expr) <- trimws(colnames(expr)); colnames(expr)[1] <- "gene"

all_cols <- colnames(expr)
sample_cols <- all_cols[grepl("^TCGA-", gsub("\\.", "-", all_cols))]
if (!length(sample_cols)){
  non_sample <- intersect(all_cols, c("gene","HUGO_SYMBOL","ENTREZ_GENE_ID"))
  sample_cols <- setdiff(all_cols, non_sample)
}
barcodes <- gsub("\\.", "-", sample_cols)
is_primary <- substr(barcodes, 14, 15) == "01"
sample_cols <- sample_cols[is_primary]; barcodes <- barcodes[is_primary]
stopifnot(length(sample_cols) > 0)

enpp1_row <- which(toupper(expr$gene)=="ENPP1"); stopifnot(length(enpp1_row)==1)
enpp1_vals <- as.numeric(as.matrix(expr[enpp1_row, sample_cols, drop=FALSE]))
enpp1_tbl <- tibble(patient_id = substr(barcodes, 1, 12),
                    ENPP1_log2 = log2(enpp1_vals + 1)) %>%
  dplyr::group_by(patient_id) %>% dplyr::summarise(ENPP1_log2 = dplyr::first(ENPP1_log2), .groups="drop")

## ---------------- 3) PAM50 from your PAM50.txt -------------------------
pam <- data.table::fread(file.path(datadir, "PAM50.txt"), sep="\t", data.table=FALSE)
pam_tab <- pam %>%
  dplyr::transmute(
    patient_id    = substr(gsub("\\.", "-", Sample), 1, 12),
    Type          = tolower(trimws(Type)),
    PAM50_subtype = dplyr::case_when(
      toupper(PAM50) == "LUMA"  ~ "Luminal A",
      toupper(PAM50) == "LUMB"  ~ "Luminal B",
      toupper(PAM50) == "HER2"  ~ "HER2",
      toupper(PAM50) == "BASAL" ~ "Basal",
      TRUE ~ NA_character_
    )
  ) %>%
  dplyr::filter(!is.na(PAM50_subtype)) %>%
  dplyr::mutate(priority = ifelse(Type=="tumor", 1, 2)) %>%
  dplyr::arrange(patient_id, priority) %>%
  dplyr::group_by(patient_id) %>%
  dplyr::summarise(PAM50_subtype = dplyr::first(PAM50_subtype), .groups="drop")

## ---------------- 4) Receptors → TNBC (robust) -------------------------
## Preferred source: TCGA_BRCA_clinicalMatrix.tsv
tnbc_from_clinicalMatrix <- function(path){
  cm <- data.table::fread(path, data.table=FALSE)
  names(cm) <- norm_names(names(cm))
  if (!"SAMPLE" %in% names(cm)) names(cm)[1] <- "SAMPLE"
  
  # match columns by many possible names
  erc <- names(cm)[grepl("^ER(_STATUS.*|_STATUS_BY_IHC$|$)", names(cm))][1]
  prc <- names(cm)[grepl("^PR(_STATUS.*|_STATUS_BY_IHC$|$)", names(cm))][1]
  h2c <- names(cm)[grepl("^HER2(_.*STATUS|_STATUS_BY_IHC$|_FINAL_STATUS$|_OVERALL_STATUS$|$)", names(cm))][1]
  if (any(is.na(c(erc,prc,h2c)))) return(NULL)
  
  tibble(
    patient_id = substr(gsub("\\.", "-", cm$SAMPLE), 1, 12),
    ER_neg     = is_neg(cm[[erc]]),
    PR_neg     = is_neg(cm[[prc]]),
    HER2_neg   = is_neg(cm[[h2c]])
  ) %>%
    dplyr::mutate(TNBC_flag = ifelse(ER_neg & PR_neg & HER2_neg, "TNBC", NA_character_)) %>%
    dplyr::select(patient_id, TNBC_flag)
}

## Fallback: PanCanAtlas patient file (if it has IHC fields)
tnbc_from_panCan <- function(path){
  df <- read_clin(path); if (is.null(df)) return(NULL)
  erc <- pick_col(df, c("^ER_STATUS_BY_IHC$","^ER_.*STATUS"))
  prc <- pick_col(df, c("^PR_STATUS_BY_IHC$","^PR_.*STATUS"))
  h2c <- pick_col(df, c("^HER2_STATUS_BY_IHC$","^HER2_FINAL_STATUS$","^HER2_.*STATUS"))
  pat <- pick_col(df, c("^PATIENT_IDENTIFIER$","^BCR_PATIENT_BARCODE$","^PATIENT_ID$"))
  if (any(is.na(c(erc,prc,h2c,pat)))) return(NULL)
  
  tibble(
    patient_id = substr(toupper(df[[pat]]), 1, 12),
    ER_neg     = is_neg(df[[erc]]),
    PR_neg     = is_neg(df[[prc]]),
    HER2_neg   = is_neg(df[[h2c]])
  ) %>%
    dplyr::mutate(TNBC_flag = ifelse(ER_neg & PR_neg & HER2_neg, "TNBC", NA_character_)) %>%
    dplyr::select(patient_id, TNBC_flag)
}

tnbc_tbl <- NULL
cm_path  <- file.path(datadir, "TCGA_BRCA_clinicalMatrix.tsv")
if (file.exists(cm_path)) tnbc_tbl <- tnbc_from_clinicalMatrix(cm_path)
