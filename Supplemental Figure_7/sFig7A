cat("TNBC counts:\n");    print(table(dat$TNBC_flag,     useNA="ifany"))

## ---------------- 6) KM plots & export -----------------------
run_km_pack <- function(df, label, outfile_pdf){
  if (nrow(df) < 20) { message(label, ": too few patients (", nrow(df), "), skipping."); return(invisible(NULL)) }
  
  med_cut <- stats::median(df$ENPP1_log2, na.rm=TRUE)
  df$grp_median <- ifelse(df$ENPP1_log2 > med_cut, "ENPP1 High", "ENPP1 Low")
  g_med <- if (dplyr::n_distinct(df$grp_median) < 2) NULL else {
    fit_m <- survfit(Surv(OS_months, OS_event) ~ grp_median, data=df)
    ggsurvplot(fit_m, data=df, risk.table=TRUE, pval=TRUE,
               title=paste0("TCGA-BRCA ", label, " — Median split\nENPP1 log2(RSEM+1) median = ", round(med_cut, 3)),
               xlab="Months", ylab="Overall survival probability",
               conf.int=FALSE, linetype=1, legend.title="", risk.table.height=0.25)
  }
  
  g_best <- NULL
  scp <- tryCatch(surv_cutpoint(df, time="OS_months", event="OS_event",
                                variables="ENPP1_log2", minprop=0.1), error=function(e) NULL)
  if (!is.null(scp)) {
    best_cut <- scp$cutpoint$cutpoint[1]
    df$grp_best <- ifelse(df$ENPP1_log2 > best_cut, "ENPP1 High", "ENPP1 Low")
    if (dplyr::n_distinct(df$grp_best) >= 2) {
      fit_b <- survfit(Surv(OS_months, OS_event) ~ grp_best, data=df)
      g_best <- ggsurvplot(fit_b, data=df, risk.table=TRUE, pval=TRUE,
                           title=paste0("TCGA-BRCA ", label, " — Best cut (surv_cutpoint)\nENPP1 best cut = ", round(best_cut, 3)),
                           xlab="Months", ylab="Overall survival probability",
                           conf.int=FALSE, linetype=1, legend.title="", risk.table.height=0.25)
    }
  }
  
  plots <- Filter(Negate(is.null), list(g_med, g_best))
  if (!length(plots)) { message(label, ": no plots to export."); return(invisible(NULL)) }
  pdf(outfile_pdf, width=6.8, height=6.8, onefile=TRUE); for (g in plots) print(g); dev.off()
  message("Saved: ", outfile_pdf)
}

cohorts <- list(
  "Luminal A" = dat %>% dplyr::filter(PAM50_subtype=="Luminal A"),
  "Luminal B" = dat %>% dplyr::filter(PAM50_subtype=="Luminal B"),
  "HER2"      = dat %>% dplyr::filter(PAM50_subtype=="HER2"),
  "Basal"     = dat %>% dplyr::filter(PAM50_subtype=="Basal"),
  "TNBC"      = dat %>% dplyr::filter(TNBC_flag=="TNBC")
)

for (nm in names(cohorts)) {
  f <- file.path(outdir, paste0("TCGA_BRCA_ENPP1_KM_", gsub("[^A-Za-z0-9]+","_", nm), ".pdf"))
  run_km_pack(cohorts[[nm]], nm, f)
}

