#!/usr/bin/env Rscript

## =============================================================
## TCGA-BRCA | ENPP1 High vs Low | CIBERSORT (LM22) boxplots
## Output: PDF figure + CSV tables (CIBERSORT results + stats)
## =============================================================

suppressPackageStartupMessages({
  pkgs <- c("data.table","dplyr","stringr","tibble","tidyr","ggplot2")
  need <- setdiff(pkgs, rownames(installed.packages()))
  if (length(need)) install.packages(need, repos = "https://cloud.r-project.org")
  lapply(pkgs, library, character.only = TRUE)
})

## ---- EDIT THIS (project root) ----
base_dir <- "~/Desktop/immune_enrichment_cibersort"   
data_dir <- file.path(base_dir, "data")
out_dir  <- file.path(base_dir, "output")
fig_dir  <- file.path(out_dir, "figures")
tab_dir  <- file.path(out_dir, "tables")
dir.create(fig_dir, recursive = TRUE, showWarnings = FALSE)
dir.create(tab_dir, recursive = TRUE, showWarnings = FALSE)

expr_path <- file.path(data_dir, "TCGA-BRCA.txt")     
ciber_r   <- file.path(data_dir, "CIBERSORT.R")       
lm22_path <- file.path(data_dir, "LM22.txt")          

stopifnot(file.exists(expr_path), file.exists(ciber_r), file.exists(lm22_path))
source(ciber_r)

## ------------------------- helpers -------------------------

# TCGA barcode sample type (e.g., "01" primary tumor, "11" normal)
tcga_sample_type <- function(barcode){
  barcode <- as.character(barcode)
  ifelse(nchar(barcode) >= 15, substr(barcode, 14, 15), NA_character_)
}

# robustly detect gene column
detect_gene_col <- function(dt){
  cand <- c("Hugo_Symbol","GeneSymbol","Gene","gene","Symbol","symbol")
  hit <- intersect(cand, names(dt))
  if (length(hit) >= 1) return(hit[1])
  return(names(dt)[1]) # fallback: first column
}

# significance stars
p_to_star <- function(p){
  if (is.na(p)) return("")
  if (p < 0.001) return("***")
  if (p < 0.01)  return("**")
  if (p < 0.05)  return("*")
  return("")
}

## ------------------------- 1) read expression -------------------------
message("[1/5] Reading expression: ", expr_path)
dt <- data.table::fread(expr_path, data.table = FALSE, showProgress = TRUE)

gene_col <- detect_gene_col(dt)
message("Detected gene column: ", gene_col)

# keep unique genes (first occurrence)
dt <- dt[!duplicated(dt[[gene_col]]), ]

# sample columns
sample_cols <- setdiff(names(dt), gene_col)

# tumor selection (default: primary tumor '01')
stype <- tcga_sample_type(sample_cols)
keep_samples <- sample_cols[stype %in% c("01")]   # primary tumor only
if (length(keep_samples) < 10) {
  stop("Too few primary tumor samples detected. Check TCGA barcode format in column names.")
}

expr <- dt[, c(gene_col, keep_samples)]
rownames(expr) <- expr[[gene_col]]
expr[[gene_col]] <- NULL

# numeric matrix
expr_mat <- as.matrix(sapply(expr, as.numeric))
rownames(expr_mat) <- rownames(expr)

## ------------------------- 2) ENPP1 high/low -------------------------
message("[2/5] Defining ENPP1 high/low by median (primary tumors)")
if (!("ENPP1" %in% rownames(expr_mat))) stop("ENPP1 not found in expression matrix rownames.")

enpp1 <- expr_mat["ENPP1", ]
cut_median <- median(enpp1, na.rm = TRUE)
enpp1_group <- ifelse(enpp1 >= cut_median, "High", "Low")
enpp1_annot <- tibble::tibble(sample_id = names(enpp1),
                             ENPP1_expr = as.numeric(enpp1),
                             ENPP1 = factor(enpp1_group, levels = c("Low","High")))

## ------------------------- 3) run CIBERSORT -------------------------
message("[3/5] Running CIBERSORT (LM22) ...")

# CIBERSORT expects a data.frame with gene symbols in first column
mix_df <- data.frame(GeneSymbol = rownames(expr_mat), expr_mat, check.names = FALSE)

# NOTE: QN (quantile normalization) should generally be FALSE for RNA-seq
ciber_res <- CIBERSORT(sig_matrix = lm22_path,
                       mixture_file = mix_df,
                       perm = 100, QN = FALSE)

# CIBERSORT output rownames are sample IDs
ciber_df <- ciber_res %>%
  tibble::rownames_to_column("sample_id") %>%
  as_tibble()

# merge ENPP1 group
dat <- ciber_df %>%
  inner_join(enpp1_annot, by = "sample_id")

# save full table
write.csv(dat, file.path(tab_dir, "TCGA_BRCA_CIBERSORT_LM22_ENPP1.csv"), row.names = FALSE)

## ------------------------- 4) long format + stats -------------------------
message("[4/5] Preparing plot data + statistics")

# LM22 cell types (exclude diagnostic columns if present)
diag_cols <- intersect(c("P.value","Correlation","RMSE"), names(dat))
cell_cols <- setdiff(names(dat), c("sample_id","ENPP1_expr","ENPP1", diag_cols))

# order + pretty labels (match your screenshot style)
lymphoid <- c("T cells gamma delta","NK cells resting","NK cells activated",
              "T cells CD8","T cells CD4 naive","T cells regulatory (Tregs)",
              "T cells CD4 memory resting","T cells CD4 memory activated","T cells follicular helper",
              "B cells naive","B cells memory","Plasma cells")

myeloid  <- c("Monocytes","Macrophages M0","Macrophages M1","Macrophages M2",
              "Dendritic cells resting","Dendritic cells activated",
              "Mast cells resting","Mast cells activated","Eosinophils","Neutrophils")

# keep only those present in output (robust to naming)
lymphoid <- lymphoid[lymphoid %in% cell_cols]
myeloid  <- myeloid[myeloid %in% cell_cols]

label_map <- c(
  "T cells gamma delta"          = "γδ T cells",
  "NK cells resting"             = "NK (rest.)",
  "NK cells activated"           = "NK (act.)",
  "T cells CD8"                  = "CD8 T cell",
  "T cells CD4 naive"            = "CD4\n(Naive)",
  "T cells regulatory (Tregs)"   = "CD4\n(Treg)",
  "T cells CD4 memory resting"   = "CD4\n(resting)",
  "T cells CD4 memory activated" = "CD4\n(activated)",
  "T cells follicular helper"    = "CD4 (T_FH)",
  "B cells naive"                = "B cells\n(naive)",
  "B cells memory"               = "B cells\n(memory)",
  "Plasma cells"                 = "Plasma\ncells",
  "Monocytes"                    = "Monocytes",
  "Macrophages M0"               = "Macs (M0)",
  "Macrophages M1"               = "Macs (M1)",
  "Macrophages M2"               = "Macs (M2)",
  "Dendritic cells resting"      = "DCs\n(resting)",
  "Dendritic cells activated"    = "DCs\n(activated)",
  "Mast cells resting"           = "Mast cells\n(resting)",
  "Mast cells activated"         = "Mast cells\n(activated)",
  "Eosinophils"                  = "Eosinophils",
  "Neutrophils"                  = "Neutrophils"
)

plot_df <- dat %>%
  select(sample_id, ENPP1, all_of(cell_cols)) %>%
  tidyr::pivot_longer(cols = all_of(cell_cols), names_to = "cell", values_to = "score") %>%
  mutate(panel = case_when(
    cell %in% lymphoid ~ "Lymphoid",
    cell %in% myeloid  ~ "Myeloid",
    TRUE ~ "Other"
  )) %>%
  filter(panel %in% c("Lymphoid","Myeloid")) %>%
  mutate(cell = factor(cell, levels = c(lymphoid, myeloid)),
         cell_lab = ifelse(as.character(cell) %in% names(label_map),
                           unname(label_map[as.character(cell)]),
                           as.character(cell)))

# stats per cell type
stat_df <- plot_df %>%
  group_by(cell) %>%
  summarize(
    p = tryCatch(wilcox.test(score ~ ENPP1)$p.value, error = function(e) NA_real_),
    star = p_to_star(p),
    y = max(score, na.rm = TRUE) * 1.08,
    .groups = "drop"
  ) %>%
  mutate(cell_lab = ifelse(as.character(cell) %in% names(label_map),
                           unname(label_map[as.character(cell)]),
                           as.character(cell)))

write.csv(stat_df, file.path(tab_dir, "TCGA_BRCA_ENPP1_LM22_wilcox_pvalues.csv"), row.names = FALSE)

## ------------------------- 5) plot -------------------------
message("[5/5] Plotting to PDF")

p <- ggplot(plot_df, aes(x = cell_lab, y = score, fill = ENPP1)) +
  geom_boxplot(outlier.shape = NA, width = 0.65) +
  geom_jitter(width = 0.18, size = 1.2, alpha = 0.35, color = "black") +
  facet_wrap(~panel, ncol = 1, scales = "free_x") +
  scale_fill_manual(values = c("Low" = "#31B6D8", "High" = "#F05A4A")) +
  labs(x = NULL, y = "Enrichment score", fill = NULL) +
  theme_classic(base_size = 12) +
  theme(
    legend.position = "top",
    axis.text.x = element_text(angle = 0, hjust = 0.5),
    strip.background = element_blank(),
    strip.text = element_text(face = "bold")
  )

# add stars (one per cell)
p <- p + geom_text(
  data = stat_df,
  aes(x = cell_lab, y = y, label = star),
  inherit.aes = FALSE,
  size = 5
)

pdf(file.path(fig_dir, "FigureC_TCGA_BRCA_ENPP1_CIBERSORT_LM22.pdf"),
    width = 16, height = 7, useDingbats = FALSE)
print(p)
dev.off()

message("DONE.\n- Figure: ", file.path(fig_dir, "FigureC_TCGA_BRCA_ENPP1_CIBERSORT_LM22.pdf"),
        "\n- Tables: ", tab_dir)
